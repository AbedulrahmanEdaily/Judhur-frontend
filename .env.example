# Empty in development → same origin through the Vite proxy; full backend URL in production
VITE_API_BASE_URL=
# Google Maps API key (Maps JavaScript API + Geocoding API). Empty → maps show their fallback.
VITE_GOOGLE_MAPS_API_KEY=
# Google Maps map ID (Google Cloud → Map Management). Empty → Google's DEMO_MAP_ID.
VITE_GOOGLE_MAPS_MAP_ID=
# Google sign-in: the OAuth Web client ID (public by nature). Empty → the Google button is hidden.
# The project's ID is already committed in .env.development and .env.production.
VITE_GOOGLE_CLIENT_ID=
